<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Orion.Desktop.ViewModels" xmlns:content="using:Orion.Desktop.Content"
        x:Class="Orion.Desktop.Views.ChangelogWindow" x:DataType="vm:ChangelogViewModel"
        Title="{Binding Text[Changelogs]}" Width="800" Height="680" MinWidth="560" MinHeight="420" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="28">
    <StackPanel Spacing="14" Margin="0,0,0,20">
      <TextBlock Text="{Binding Text[Changelogs]}" Classes="heading" />
      <TextBlock Text="{Binding Text[ChangelogHint]}" Classes="muted" TextWrapping="Wrap" />
      <ComboBox ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" HorizontalAlignment="Stretch" />
      <Border Background="{DynamicResource OrionWarningSurfaceBrush}" CornerRadius="8" Padding="12" IsVisible="{Binding SelectedEntry.IsLegacy}">
        <TextBlock Text="{Binding Text[LegacyChangelogWarning]}" Foreground="{DynamicResource OrionWarningTextBrush}" TextWrapping="Wrap" FontSize="12" />
      </Border>
    </StackPanel>
    <Border Grid.Row="1" Classes="panel" Padding="20">
      <ScrollViewer x:Name="NotesScroll" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Blocks}" Margin="0,0,12,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="content:ChangelogBlock">
              <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                <TextBlock Text="•" IsVisible="{Binding IsBullet}" Foreground="{DynamicResource OrionAccentBrush}" Margin="0,0,10,0" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" Classes.section="{Binding IsHeading}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    <Button Grid.Row="2" Content="{Binding Text[Close]}" Click="CloseClicked" HorizontalAlignment="Right" Margin="0,20,0,0" />
  </Grid>
  <Window.Styles>
    <Style Selector="SelectableTextBlock"><Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="{DynamicResource OrionTextBrush}" /></Style>
    <Style Selector="SelectableTextBlock.section"><Setter Property="FontSize" Value="19" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource OrionTextBrush}" /><Setter Property="Margin" Value="0,10,0,2" /></Style>
  </Window.Styles>
</Window>
