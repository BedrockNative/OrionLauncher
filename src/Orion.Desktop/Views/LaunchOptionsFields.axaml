<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Orion.Desktop.ViewModels" xmlns:views="using:Orion.Desktop.Views" x:Class="Orion.Desktop.Views.LaunchOptionsFields" x:DataType="vm:LaunchOptionsViewModel">
  <UserControl.Styles>
    <Style Selector="TabControl.settingsTabs > TabItem">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,13" />
      <Setter Property="MinWidth" Value="148" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="TabControl.settingsTabs > TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource OrionAccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource OrionSelectionBrush}" />
    </Style>
  </UserControl.Styles>
  <TabControl Classes="settingsTabs" TabStripPlacement="Left" SelectedIndex="{Binding SelectedTab}">
    <TabItem Header="{Binding Text[GeneralTab]}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16" Margin="22,8,8,0" IsEnabled="{Binding CanEdit}">
        <TextBlock Text="{Binding Text[GeneralTab]}" FontSize="20" FontWeight="SemiBold" />
        <StackPanel Spacing="8" IsVisible="{Binding IsExisting}">
          <TextBlock Text="{Binding Text[Name]}" FontWeight="SemiBold" />
          <TextBox Text="{Binding Name}" MaxLength="80" />
        </StackPanel>
        <StackPanel Spacing="6">
      <TextBlock Text="{Binding Text[InstanceAccount]}" FontWeight="SemiBold" />
      <ComboBox x:Name="InstanceAccountPicker" ItemsSource="{Binding AccountChoices}" SelectedItem="{Binding SelectedAccount}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxDropDownHeight="320">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:AccountChoice">
            <Grid ColumnDefinitions="38,*" ColumnSpacing="12" Margin="0,3" ToolTip.Tip="{Binding Label}">
              <views:ProfileAvatar DataContext="{Binding Profile}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{Binding Label}" IsVisible="{Binding IsCurrent}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Profile.DisplayName}" IsVisible="{Binding HasProfile}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Label}" IsVisible="{Binding ShowFallback}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Profile.Username}" IsVisible="{Binding Profile.HasGamertag, FallbackValue=False}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="{Binding Text[InstanceAccountHint]}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
        <Border Background="{DynamicResource OrionMaterialInsetBrush}" BorderBrush="{DynamicResource OrionBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
          <StackPanel Spacing="6">
            <CheckBox Content="{Binding Text[InstanceShortcut]}" IsChecked="{Binding DesktopShortcut}" />
            <TextBlock Text="{Binding Text[InstanceShortcutHint]}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
    </TabItem>
      <TabItem Header="{Binding Text[LaunchTab]}" IsEnabled="{Binding CanEdit}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12" Margin="22,8,8,0">
            <TextBlock Text="{Binding Text[LaunchOptions]}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Text[LaunchCommand]}" FontWeight="SemiBold" />
            <TextBox Text="{Binding LaunchCommand}" Watermark="prime-run %command%" />
            <TextBlock Text="{Binding Text[LaunchCommandHint]}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Text[GameArguments]}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Text[GameArgumentsHint]}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <TextBox Text="{Binding ArgumentLines}" AcceptsReturn="True" Height="100" TextWrapping="Wrap" Watermark="--example-flag" />
            <CheckBox Content="{Binding Text[ShowLogOnLaunch]}" IsChecked="{Binding ShowLogOnLaunch}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{Binding Text[EnvironmentTab]}" IsEnabled="{Binding CanEdit}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12" Margin="22,8,8,0">
            <TextBlock Text="{Binding Text[EnvironmentTab]}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Text[EnvironmentVariables]}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Text[EnvironmentHint]}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <TextBox Text="{Binding EnvironmentLines}" AcceptsReturn="True" Height="180" TextWrapping="Wrap" Watermark="__NV_PRIME_RENDER_OFFLOAD=1&#10;__GLX_VENDOR_LIBRARY_NAME=nvidia" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{Binding Text[ResolutionTab]}" IsEnabled="{Binding CanEdit}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="16" Margin="22,8,8,0">
            <TextBlock Text="{Binding Text[ResolutionTab]}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Text[MonitorResolutions]}" FontWeight="SemiBold" />
            <ComboBox x:Name="MonitorResolutionPicker" ItemsSource="{Binding MonitorResolutions}" SelectedItem="{Binding SelectedMonitorResolution}" HorizontalAlignment="Stretch" />
            <TextBlock Text="{Binding Text[MonitorResolutionHint]}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <CheckBox Content="{Binding Text[CustomResolution]}" IsChecked="{Binding CustomResolution}" />
            <Grid ColumnDefinitions="*,Auto,*" IsEnabled="{Binding CanEditResolution}">
              <StackPanel Spacing="6"><TextBlock Text="{Binding Text[Width]}" /><TextBox Text="{Binding Width}" MaxLength="5" /></StackPanel>
              <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Bottom" Margin="12" />
              <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="{Binding Text[Height]}" /><TextBox Text="{Binding Height}" MaxLength="5" /></StackPanel>
            </Grid>
            <CheckBox Content="{Binding Text[Fullscreen]}" IsChecked="{Binding Fullscreen}" IsEnabled="{Binding CustomResolution}" />
            <TextBlock Text="{Binding Text[ResolutionHint]}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{Binding Text[InstanceAppearance]}" IsEnabled="{Binding CanEdit}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12" Margin="22,8,8,0">
            <TextBlock Text="{Binding Text[InstanceAppearance]}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Text[CoverHint]}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <ComboBox ItemsSource="{Binding CoverChoices}" SelectedItem="{Binding SelectedCover}" HorizontalAlignment="Stretch" />
            <Border CornerRadius="10" ClipToBounds="True" Width="320" HorizontalAlignment="Left">
              <views:InstanceCoverView CoverId="{Binding SelectedCover.Id}" Store="{Binding CoverStore}" Text="{Binding Text}" />
            </Border>
            <TextBlock Text="{Binding Text[CoverCredit]}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            <WrapPanel>
              <Button Content="{Binding Text[CoverSource]}" Classes="subtle" Click="OpenCoverLink" CommandParameter="source" IsEnabled="{Binding HasCover}" Padding="0,5,14,5" FontSize="12" />
              <Button Content="CC BY 3.0 ↗" Classes="subtle" Click="OpenCoverLink" CommandParameter="license" Padding="0,5" FontSize="12" />
            </WrapPanel>
            <TextBlock Text="{Binding CoverLinkError}" Foreground="{DynamicResource OrionErrorTextBrush}" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    <TabItem Header="{Binding Text[ManageTab]}" IsVisible="{Binding IsExisting}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18" Margin="22,8,8,0">
          <TextBlock Text="{Binding Text[ManageTab]}" FontSize="20" FontWeight="SemiBold" />
          <Border Classes="panel" Padding="18">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding Text[InstanceLog]}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Text[SettingsLogHint]}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
              <Button Content="{Binding Text[DetachLog]}" Click="OpenInstanceLog" />
            </StackPanel>
          </Border>
          <Border Classes="panel" Padding="18">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding Text[InstanceFiles]}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Text[InstanceFilesHint]}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
              <Button Content="{Binding Text[Folder]}" Command="{Binding Card.FolderCommand}" />
              <Button Content="{Binding Text[OpenContentFolder]}" Command="{Binding Card.ContentFolderCommand}" />
              <TextBlock Text="{Binding Text[ContentStorageHint]}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource OrionErrorSurfaceBrush}" BorderBrush="{DynamicResource OrionErrorBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding Text[Archive]}" FontWeight="SemiBold" Foreground="{DynamicResource OrionErrorTextBrush}" />
              <TextBlock Text="{Binding Text[ArchiveText]}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
              <Button Content="{Binding Text[Archive]}" Command="{Binding Card.ArchiveCommand}" IsEnabled="{Binding CanEdit}" Foreground="{DynamicResource OrionErrorTextBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="{Binding Text[ContentTitle]}" IsVisible="{Binding IsExisting}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16" Margin="22,8,8,0">
        <TextBlock Text="{Binding Text[ContentTitle]}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Text[ContentOverview]}" Classes="muted" TextWrapping="Wrap" />
        <Border Background="{DynamicResource OrionWarningSurfaceBrush}" CornerRadius="10" Padding="12">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding Text[ContentExperimentalTitle]}" FontWeight="SemiBold" Foreground="{DynamicResource OrionWarningTextBrush}" />
            <TextBlock Text="{Binding Text[ContentExperimentalNotice]}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource OrionWarningTextBrush}" />
          </StackPanel>
        </Border>
        <Border Classes="panel" Padding="20">
          <StackPanel Spacing="14">
            <TextBlock Text="{Binding Text[ContentCategories]}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Text[ContentSafetyHint]}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <Button Content="{Binding Text[ContentOpen]}" Click="OpenContent" Classes="primary" IsEnabled="{Binding CanEdit}" />
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="MangoHud" IsEnabled="{Binding CanEdit}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="22,8,8,0">
          <TextBlock Text="MangoHud" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Text[MangoHudIntro]}" Classes="muted" TextWrapping="Wrap" />
          <Border Classes="panel" Padding="16">
            <StackPanel Spacing="8">
              <CheckBox x:Name="MangoHudEnabledToggle" Content="{Binding Text[MangoHudEnable]}" IsChecked="{Binding MangoHudEnabled}" />
              <TextBlock Text="{Binding Text[MangoHudFound]}" IsVisible="{Binding MangoHudAvailable}" Foreground="{DynamicResource OrionAccentBrush}" TextWrapping="Wrap" FontSize="12" />
              <TextBlock Text="{Binding Text[MangoHudMissing]}" IsVisible="{Binding !MangoHudAvailable}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
              <Button Content="{Binding Text[MangoHudRefresh]}" Command="{Binding RefreshMangoHudCommand}" Classes="subtle" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
          <Border Classes="panel" Padding="16" IsEnabled="{Binding MangoHudEnabled}">
            <StackPanel Spacing="8">
              <CheckBox x:Name="MangoHudSystemConfigToggle" Content="{Binding Text[MangoHudSystemConfig]}" IsChecked="{Binding MangoHudUseSystemConfig}" />
              <TextBlock Text="{Binding Text[MangoHudSystemConfigHint]}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
          </Border>
          <Border x:Name="MangoHudMetricsPanel" Classes="panel" Padding="16" IsEnabled="{Binding CanEditMangoHudMetrics}">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding Text[MangoHudMetrics]}" FontWeight="SemiBold" />
              <WrapPanel ItemWidth="240">
                <WrapPanel.Styles>
                  <Style Selector="CheckBox">
                    <Setter Property="Margin" Value="0,0,12,4" />
                  </Style>
                </WrapPanel.Styles>
                <CheckBox x:Name="MangoHudFpsToggle" Content="FPS" IsChecked="{Binding MangoHudFps}" MinWidth="200" />
                <CheckBox Content="{Binding Text[MangoHudFrameTime]}" IsChecked="{Binding MangoHudFrameTime}" MinWidth="200" />
                <CheckBox Content="{Binding Text[MangoHudCpu]}" IsChecked="{Binding MangoHudCpu}" MinWidth="200" />
                <CheckBox Content="{Binding Text[MangoHudGpu]}" IsChecked="{Binding MangoHudGpu}" MinWidth="200" />
                <CheckBox Content="{Binding Text[MangoHudRam]}" IsChecked="{Binding MangoHudRam}" MinWidth="200" />
                <CheckBox Content="{Binding Text[MangoHudVram]}" IsChecked="{Binding MangoHudVram}" MinWidth="200" />
                <CheckBox Content="{Binding Text[MangoHudCpuTemp]}" IsChecked="{Binding MangoHudCpuTemperature}" IsEnabled="{Binding MangoHudCpu}" MinWidth="200" />
                <CheckBox Content="{Binding Text[MangoHudGpuTemp]}" IsChecked="{Binding MangoHudGpuTemperature}" IsEnabled="{Binding MangoHudGpu}" MinWidth="200" />
                <CheckBox Content="{Binding Text[MangoHudBattery]}" IsChecked="{Binding MangoHudBattery}" MinWidth="200" />
                <CheckBox Content="{Binding Text[ResolutionTab]}" IsChecked="{Binding MangoHudResolution}" MinWidth="200" />
              </WrapPanel>
              <TextBlock Text="{Binding Text[MangoHudPosition]}" FontWeight="SemiBold" />
              <ComboBox x:Name="MangoHudPositionPicker" ItemsSource="{Binding MangoHudPositions}" SelectedItem="{Binding SelectedMangoHudPosition}" HorizontalAlignment="Stretch" />
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding Text[MangoHudHint]}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</UserControl>
