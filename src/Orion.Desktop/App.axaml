<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="using:Orion.Desktop.Theming" x:Class="Orion.Desktop.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="theme:WindowAppearance.Enabled" Value="True" /></Style>
    <Style Selector="Window"><Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" /><Setter Property="Background" Value="{DynamicResource OrionWindowBrush}" /><Setter Property="Foreground" Value="{DynamicResource OrionTextBrush}" /></Style>
    <Style Selector="TextBlock"><Setter Property="FontSize" Value="14" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource OrionMutedBrush}" /></Style>
    <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="30" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LetterSpacing" Value="-0.6" /></Style>
    <Style Selector="TabItem"><Setter Property="Foreground" Value="{DynamicResource OrionMutedBrush}" /></Style>
    <Style Selector="TabItem:selected"><Setter Property="Foreground" Value="{DynamicResource OrionTextBrush}" /></Style>
    <Style Selector="TabControl.sectionTabs > TabItem"><Setter Property="FontSize" Value="14" /><Setter Property="Padding" Value="18,12" /><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="TabControl.sectionTabs > TabItem:selected"><Setter Property="Background" Value="{DynamicResource OrionSelectionBrush}" /><Setter Property="Foreground" Value="{DynamicResource OrionAccentBrush}" /></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="16,11" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Background" Value="{DynamicResource OrionInsetBrush}" /><Setter Property="Foreground" Value="{DynamicResource OrionTextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource OrionBorderBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource OrionHoverBrush}" /><Setter Property="Foreground" Value="{DynamicResource OrionTextBrush}" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource OrionAccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource OrionOnAccentBrush}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource OrionAccentHoverBrush}" /><Setter Property="Foreground" Value="{DynamicResource OrionOnAccentBrush}" /></Style>
    <Style Selector="Button.nav"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{DynamicResource OrionMutedBrush}" /><Setter Property="Padding" Value="14,14" /></Style>
    <Style Selector="Button.nav.active"><Setter Property="Background" Value="{DynamicResource OrionSelectionBrush}" /><Setter Property="Foreground" Value="{DynamicResource OrionAccentBrush}" /></Style>
    <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource OrionSelectionBrush}" /><Setter Property="Foreground" Value="{DynamicResource OrionAccentBrush}" /></Style>
    <Style Selector="Button.subtle"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{DynamicResource OrionMutedBrush}" /></Style>
    <Style Selector="Border.panel"><Setter Property="Background" Value="{DynamicResource OrionPanelBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource OrionBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="16" /><Setter Property="Padding" Value="24" /></Style>
    <Style Selector="Border.instanceCard:pointerover"><Setter Property="BorderBrush" Value="{DynamicResource OrionAccentBorderBrush}" /></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="9" /><Setter Property="Padding" Value="12,11" /><Setter Property="Background" Value="{DynamicResource OrionInsetBrush}" /><Setter Property="Foreground" Value="{DynamicResource OrionTextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource OrionBorderBrush}" /></Style>
    <Style Selector="ComboBox"><Setter Property="theme:DropdownBehavior.Enabled" Value="True" /><Setter Property="MaxDropDownHeight" Value="320" /><Setter Property="CornerRadius" Value="9" /><Setter Property="Padding" Value="12,10" /><Setter Property="Background" Value="{DynamicResource OrionInsetBrush}" /><Setter Property="Foreground" Value="{DynamicResource OrionTextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource OrionBorderBrush}" /></Style>
    <Style Selector="ToolTip"><Setter Property="MaxWidth" Value="400" /></Style>
    <Style Selector="Window.reducedMotion :is(Control)"><Setter Property="Transitions"><Transitions /></Setter></Style>
    <Style Selector="Border.panel"><Setter Property="Background" Value="{DynamicResource OrionMaterialBrush}" /></Style>
    <Style Selector="Button:not(.primary):not(.subtle):not(.nav), TextBox, ComboBox"><Setter Property="Background" Value="{DynamicResource OrionMaterialInsetBrush}" /></Style>
    <!-- Overlay popups reveal the launcher, never the desktop underneath a native popup. -->
    <Style Selector="Popup"><Setter Property="ShouldUseOverlayLayer" Value="True" /></Style>
    <Style Selector="MenuFlyoutPresenter, FlyoutPresenter, ContextMenu"><Setter Property="Background" Value="{DynamicResource OrionPopupBrush}" /></Style>
  </Application.Styles>
</Application>
